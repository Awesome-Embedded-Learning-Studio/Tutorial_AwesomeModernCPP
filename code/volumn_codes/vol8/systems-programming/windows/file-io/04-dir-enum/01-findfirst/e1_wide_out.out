setup: 建了 3 个文件;枚举回来对上号:中文=对上 emoji=对上
## e1_wide_out.out —— 由 run_wide_out.sh 汇编:每 mode 独立进程跑,stdout 落文件后
## od 十六进制留证(字节是证据),stderr 的返回值报告原样附在后面。

===== 环境事实(mode=base,程序自己报) =====
stdout isatty=0 stderr isatty=0
GetACP=936 (ANSI,本机 936=GBK)
GetOEMCP=936
GetConsoleOutputCP=936 (重定向下进程仍能读到控制台代码页设置)
setlocale(LC_ALL,nullptr)="C"
MB_CUR_MAX=1

===== mode=a =====
-- stderr 报告:
mode=a 运行时拿到:cn(经 CP_UTF8 转写)=中文文件.txt
printf(%ls) 中文行返回 10,emoji 行返回 18(负数=失败;写到哪断了看 od)
-- stdout 字节数: 30
-- stdout 内容(尽力按 UTF-8 显示):
[a] cn=[]
[a] emoji=[emoji]
-- stdout 字节十六进制(od -An -tx1):
 5b 61 5d 20 63 6e 3d 5b 5d 0d 0a 5b 61 5d 20 65
 6d 6f 6a 69 3d 5b 65 6d 6f 6a 69 5d 0d 0a

===== mode=b =====
-- stderr 报告:
mode=b 运行时拿到:cn(经 CP_UTF8 转写)=中文文件.txt
wprintf(%ls) 中文行返回 18,emoji 行返回 24
-- stdout 字节数: 44
-- stdout 内容(尽力按 UTF-8 显示):
[b] cn=[????.txt]
[b] emoji=[emoji??.txt]
-- stdout 字节十六进制(od -An -tx1):
 5b 62 5d 20 63 6e 3d 5b 3f 3f 3f 3f 2e 74 78 74
 5d 0d 0a 5b 62 5d 20 65 6d 6f 6a 69 3d 5b 65 6d
 6f 6a 69 3f 3f 2e 74 78 74 5d 0d 0a

