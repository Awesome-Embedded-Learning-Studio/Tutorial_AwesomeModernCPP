:name: F407 Blink PD12
:description: STM32F407 闪灯 - 翻转 PD12(Discovery UserLED),跑 1 秒后采几次 ODR 证翻转

using sysbus
mach create
machine LoadPlatformDescription @platforms/boards/stm32f4_discovery.repl

$bin?=$ORIGIN/build/blink.elf

macro reset
"""
    sysbus LoadELF $bin
"""
runMacro $reset

emulation RunFor "00:00:01.000000"

echo "=== PD12 翻转证明(GPIOD_ODR @0x40020C14,bit12 应在 0/0x1000 跳)==="
sysbus ReadDoubleWord 0x40020C14
emulation RunFor "00:00:00.020000"
sysbus ReadDoubleWord 0x40020C14
emulation RunFor "00:00:00.020000"
sysbus ReadDoubleWord 0x40020C14
