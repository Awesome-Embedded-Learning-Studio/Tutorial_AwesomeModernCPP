{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "strict": true,
    "resolveJsonModule": true, "esModuleInterop": true, "skipLibCheck": true,
    "types": ["vite/client", "node"], "noEmit": true,
    "paths": { "@asm-playground": ["./src/index.ts"] }
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "demo/**/*.ts", "demo/**/*.vue", "vite.config.ts", "tests/**/*.ts"]
}
