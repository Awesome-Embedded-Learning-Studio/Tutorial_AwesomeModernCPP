{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "asm-executor/payload@1",
  "type": "object", "required": ["format", "meta", "code", "initial", "execution"],
  "definitions": { "hex": { "type": "string", "pattern": "^0x[0-9a-fA-F]+$" } },
  "properties": {
    "format": { "const": "asm-executor/payload@1" },
    "meta": {
      "type": "object", "required": ["isa", "syntax", "title", "entry"],
      "properties": {
        "isa": { "enum": ["x86-64", "thumb-2"] }, "syntax": { "enum": ["att", "intel", "unified"] },
        "title": { "type": "string", "minLength": 1 }, "entry": { "$ref": "#/definitions/hex" }
      }
    },
    "code": {
      "type": "array", "minItems": 1,
      "items": { "type": "object", "required": ["addr", "bytes", "text"], "properties": {
        "addr": { "$ref": "#/definitions/hex" }, "bytes": { "type": "string", "pattern": "^(?:[0-9a-fA-F]{2})+$" }, "text": { "type": "string", "minLength": 1 }
      } }
    },
    "initial": {
      "type": "object", "required": ["regs", "memory"], "properties": {
        "regs": { "type": "object", "additionalProperties": { "$ref": "#/definitions/hex" } },
        "memory": { "type": "array", "minItems": 1, "items": {
          "type": "object", "required": ["addr", "size", "perms", "bytes"], "properties": {
            "addr": { "$ref": "#/definitions/hex" }, "size": { "type": "integer", "minimum": 4096, "maximum": 16777216, "multipleOf": 4096 },
            "perms": { "type": "string", "pattern": "^(?:r|w|x|rw|rx|wx|rwx)$" }, "bytes": { "type": "string" }
          }
        } }
      }
    },
    "execution": {
      "type": "object", "required": ["stop_before"], "properties": {
        "stop_before": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/definitions/hex" } },
        "max_steps": { "type": "integer", "minimum": 1, "maximum": 10000 }
      }
    },
    "ui": {
      "type": "object", "properties": {
        "watch_regs": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "type": "string" } },
        "stack_window": { "type": "object", "required": ["around", "rows"], "properties": {
          "around": { "type": "string" }, "rows": { "type": "integer", "minimum": 1, "maximum": 64 }
        } }
      }
    }
  }
}
