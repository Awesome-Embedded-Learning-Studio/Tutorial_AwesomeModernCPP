<mxfile host="app.diagrams.net">
  <diagram name="MMIO vs Memory" id="mmio-vs-memory">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="同一套 load/store，两种地址的两种性格" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="140" y="18" width="520" height="32" as="geometry" />
        </mxCell>

        <!-- ===================== Left: SRAM ===================== -->
        <mxCell id="sram_frame" value="SRAM · 0x20000000 起" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#1B5E20;strokeWidth=2;fillColor=none;verticalAlign=top;fontSize=14;fontStyle=1;fontColor=#1B5E20;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="60" y="66" width="330" height="340" as="geometry" />
        </mxCell>

        <mxCell id="sram_write" value="&lt;b&gt;str&lt;/b&gt; 写入 0x22" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#1B5E20;strokeWidth=1.5;fillColor=#E8F5E9;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="110" y="106" width="230" height="44" as="geometry" />
        </mxCell>
        <mxCell id="sram_cell" value="格子里的内容&lt;br&gt;&lt;b&gt;0x00000022&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#1B5E20;strokeWidth=2;fillColor=#C8E6C9;fontSize=13;align=center;verticalAlign=middle;fontFamily=Consolas;" vertex="1" parent="1">
          <mxGeometry x="130" y="200" width="190" height="56" as="geometry" />
        </mxCell>
        <mxCell id="sram_read" value="&lt;b&gt;ldr&lt;/b&gt; 读回 0x22" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#1B5E20;strokeWidth=1.5;fillColor=#E8F5E9;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="110" y="306" width="230" height="44" as="geometry" />
        </mxCell>

        <mxCell id="s_w" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1B5E20;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="sram_write" target="sram_cell">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s_w_l" value="存进去" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#1B5E20;" vertex="1" parent="1">
          <mxGeometry x="330" y="152" width="60" height="20" as="geometry" />
        </mxCell>
        <mxCell id="s_r" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1B5E20;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="sram_cell" target="sram_read">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s_r_l" value="原样取出" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#1B5E20;" vertex="1" parent="1">
          <mxGeometry x="330" y="272" width="60" height="20" as="geometry" />
        </mxCell>

        <mxCell id="sram_note" value="真内存：写进去什么，读出来什么&lt;br&gt;一进一出，对称" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;fontStyle=2;fontColor=#1B5E20;" vertex="1" parent="1">
          <mxGeometry x="80" y="366" width="290" height="40" as="geometry" />
        </mxCell>

        <!-- ===================== Right: Peripheral ===================== -->
        <mxCell id="per_frame" value="外设 · 0x40000000 起（以 GPIOC 为例）" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#E65100;strokeWidth=2;fillColor=none;verticalAlign=top;fontSize=14;fontStyle=1;fontColor=#E65100;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="440" y="66" width="340" height="340" as="geometry" />
        </mxCell>

        <mxCell id="p_write" value="&lt;b&gt;str&lt;/b&gt; 写 0x40011010&lt;br&gt;← 0x2000" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#E65100;strokeWidth=1.5;fillColor=#FFF3E0;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="460" y="106" width="140" height="56" as="geometry" />
        </mxCell>
        <mxCell id="p_circuit" value="BSRR 译码电路&lt;br&gt;bit13 置位" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#E65100;strokeWidth=2;fillColor=#FFE0B2;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="630" y="106" width="140" height="56" as="geometry" />
        </mxCell>
        <mxCell id="p_w" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#E65100;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="p_write" target="p_circuit">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p_w_l" value="下令：&lt;br&gt;PC13 顶到高" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#E65100;" vertex="1" parent="1">
          <mxGeometry x="590" y="170" width="90" height="36" as="geometry" />
        </mxCell>

        <mxCell id="p_status" value="ODR 状态上报&lt;br&gt;0x00002000" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#4A148C;strokeWidth=2;fillColor=#F3E5F5;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="630" y="250" width="140" height="56" as="geometry" />
        </mxCell>
        <mxCell id="p_read" value="&lt;b&gt;ldr&lt;/b&gt; 读 0x4001100C&lt;br&gt;→ 0x2000" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#4A148C;strokeWidth=1.5;fillColor=#EDE7F6;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="460" y="250" width="140" height="56" as="geometry" />
        </mxCell>
        <mxCell id="p_r" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A148C;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="p_status" target="p_read">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p_r_l" value="收报：&lt;br&gt;各脚输出状态" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#4A148C;" vertex="1" parent="1">
          <mxGeometry x="590" y="314" width="90" height="36" as="geometry" />
        </mxCell>

        <mxCell id="p_note" value="不是存储，是机关：写是下达命令，读是收取报告&lt;br&gt;一进一出，各有各的语义" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;fontStyle=2;fontColor=#E65100;" vertex="1" parent="1">
          <mxGeometry x="450" y="362" width="320" height="40" as="geometry" />
        </mxCell>

        <!-- Bottom note -->
        <mxCell id="bottom_note" value="两条路走的是同一套 ldr/str —— CPU 眼里都是地址；性格的差别在地址后面的电路，这就是 MMIO" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=13;fontColor=#37474F;" vertex="1" parent="1">
          <mxGeometry x="60" y="428" width="700" height="26" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
