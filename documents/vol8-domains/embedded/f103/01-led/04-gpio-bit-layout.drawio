<mxfile host="app.diagrams.net">
  <diagram name="GPIO configuration and atomic write" id="gpio-bit-layout">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="560" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="PC13 的两组关键位：CRH 配模式，BSRR 改电平" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="150" y="18" width="600" height="34" as="geometry" /></mxCell>

        <mxCell id="crh_title" value="GPIOC_CRH（每脚四位，管 pin8～15）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#37474F;" vertex="1" parent="1"><mxGeometry x="50" y="65" width="420" height="28" as="geometry" /></mxCell>
        <mxCell id="pin15" value="PC15&lt;br&gt;31:28" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#90A4AE;fillColor=#FAFAFA;fontSize=12;" vertex="1" parent="1"><mxGeometry x="50" y="100" width="100" height="58" as="geometry" /></mxCell>
        <mxCell id="pin14" value="PC14&lt;br&gt;27:24" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#90A4AE;fillColor=#FAFAFA;fontSize=12;" vertex="1" parent="1"><mxGeometry x="150" y="100" width="100" height="58" as="geometry" /></mxCell>
        <mxCell id="pin13" value="&lt;b&gt;PC13&lt;/b&gt;&lt;br&gt;bits 23:20&lt;br&gt;&lt;b&gt;0010&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#E65100;strokeWidth=3;fillColor=#FFF3E0;fontSize=12;fontColor=#BF360C;" vertex="1" parent="1"><mxGeometry x="250" y="94" width="100" height="70" as="geometry" /></mxCell>
        <mxCell id="pin12" value="PC12&lt;br&gt;19:16" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#90A4AE;fillColor=#FAFAFA;fontSize=12;" vertex="1" parent="1"><mxGeometry x="350" y="100" width="100" height="58" as="geometry" /></mxCell>
        <mxCell id="pin11" value="PC11&lt;br&gt;15:12" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#90A4AE;fillColor=#FAFAFA;fontSize=12;" vertex="1" parent="1"><mxGeometry x="450" y="100" width="100" height="58" as="geometry" /></mxCell>
        <mxCell id="pin10" value="PC10&lt;br&gt;11:8" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#90A4AE;fillColor=#FAFAFA;fontSize=12;" vertex="1" parent="1"><mxGeometry x="550" y="100" width="100" height="58" as="geometry" /></mxCell>
        <mxCell id="pin9" value="PC9&lt;br&gt;7:4" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#90A4AE;fillColor=#FAFAFA;fontSize=12;" vertex="1" parent="1"><mxGeometry x="650" y="100" width="100" height="58" as="geometry" /></mxCell>
        <mxCell id="pin8" value="PC8&lt;br&gt;3:0" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#90A4AE;fillColor=#FAFAFA;fontSize=12;" vertex="1" parent="1"><mxGeometry x="750" y="100" width="100" height="58" as="geometry" /></mxCell>
        <mxCell id="crh_note" value="(13 - 8) × 4 = 20　→　MODE13[1:0] 在 21:20，CNF13[1:0] 在 23:22" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=13;fontColor=#E65100;" vertex="1" parent="1"><mxGeometry x="120" y="172" width="660" height="30" as="geometry" /></mxCell>

        <mxCell id="bsrr_title" value="GPIOC_BSRR（写 1 生效，写 0 不动作）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#37474F;" vertex="1" parent="1"><mxGeometry x="50" y="218" width="420" height="28" as="geometry" /></mxCell>
        <mxCell id="reset_half" value="&lt;b&gt;高半字 31:16 · RESET 区&lt;/b&gt;&lt;br&gt;bit(16+n)=1 → PCn 拉低&lt;br&gt;PC13 对应 bit29" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#1565C0;strokeWidth=2.5;fillColor=#E3F2FD;fontSize=13;" vertex="1" parent="1"><mxGeometry x="50" y="255" width="390" height="82" as="geometry" /></mxCell>
        <mxCell id="set_half" value="&lt;b&gt;低半字 15:0 · SET 区&lt;/b&gt;&lt;br&gt;bit n=1 → PCn 顶高&lt;br&gt;PC13 对应 bit13" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#1B5E20;strokeWidth=2.5;fillColor=#E8F5E9;fontSize=13;" vertex="1" parent="1"><mxGeometry x="460" y="255" width="390" height="82" as="geometry" /></mxCell>
        <mxCell id="reset_mask" value="1u &lt;&lt; (13 + 16)&lt;br&gt;0x20000000" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#1565C0;fillColor=#E3F2FD;fontSize=13;fontFamily=Consolas;" vertex="1" parent="1"><mxGeometry x="105" y="365" width="220" height="52" as="geometry" /></mxCell>
        <mxCell id="set_mask" value="1u &lt;&lt; 13&lt;br&gt;0x00002000" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#1B5E20;fillColor=#E8F5E9;fontSize=13;fontFamily=Consolas;" vertex="1" parent="1"><mxGeometry x="575" y="365" width="220" height="52" as="geometry" /></mxCell>
        <mxCell id="odr13" value="&lt;b&gt;ODR.bit13 / PC13 电平&lt;/b&gt;&lt;br&gt;0 = 低，1 = 高" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#6A1B9A;strokeWidth=2.5;fillColor=#F3E5F5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="335" y="447" width="230" height="62" as="geometry" /></mxCell>
        <mxCell id="reset_edge" value="复位" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1565C0;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontColor=#1565C0;" edge="1" parent="1" source="reset_mask" target="odr13"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="set_edge" value="置位" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1B5E20;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontColor=#1B5E20;" edge="1" parent="1" source="set_mask" target="odr13"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="bottom_note" value="CRH 决定输出驱动器是否上岗；BSRR 只负责给已经配置好的输出脚下达置位 / 复位命令" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=13;fontColor=#37474F;" vertex="1" parent="1"><mxGeometry x="90" y="522" width="720" height="26" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
