        </mxCell>
        <mxCell id="cb_title" value="控制块（堆上）：删除器住在这里" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#1565C0;" vertex="1" parent="1">
          <mxGeometry x="457" y="332" width="290" height="18" as="geometry" />
        </mxCell>
        <mxCell id="cb_counts" value="引用计数：strong_count / weak_count" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#1565C0;strokeWidth=1;fillColor=#BBDEFB;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="467" y="354" width="270" height="24" as="geometry" />
        </mxCell>
        <mxCell id="cb_del" value="&lt;b&gt;销毁动作 delete impl_&lt;/b&gt;（类型擦除记进此处）" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#1565C0;strokeWidth=1;fillColor=#E3F2FD;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="467" y="382" width="270" height="34" as="geometry" />
        </mxCell>
        <mxCell id="make_note" value="销毁动作在构造点生成并记入：make_shared&lt;Impl&gt;() 所在的 cpp，Impl 在那里是完整的" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;spacing=2;" vertex="1" parent="1">
          <mxGeometry x="447" y="432" width="310" height="28" as="geometry" />
        </mxCell>
        <mxCell id="r_step" value="析构只做：引用计数减一，归零就把销毁动作转交给控制块——全程不需要 sizeof(Impl)" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#222222;strokeWidth=1;fillColor=#FFFFFF;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="447" y="476" width="310" height="44" as="geometry" />
        </mxCell>
        <mxCell id="r_verdict" value="✓ 类内 ~Widget() = default 全部通过" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#2E7D32;strokeWidth=2;fillColor=#e6f4ea;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
