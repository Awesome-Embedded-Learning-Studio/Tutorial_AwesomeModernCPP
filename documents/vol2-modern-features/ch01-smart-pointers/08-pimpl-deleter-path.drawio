        <mxCell id="t_obj" value="&lt;b&gt;Impl 对象&lt;/b&gt;（堆上）" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#2E7D32;strokeWidth=2;fillColor=#E8F5E9;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1">
