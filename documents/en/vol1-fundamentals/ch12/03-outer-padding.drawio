        <!-- 注释带 -->
        <mxCell id="ann-align" value="in 里有 int，自己也按 4 字节对齐，只能从偏移 4 开始；偏移 1–3 照样垫填充" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=13;fontColor=#555555;" vertex="1" parent="1">
