        <mxCell id="summary" value="tag 1 字节 + 填充 3 字节 + in 8 字节，算下来 &lt;b&gt;sizeof(Outer) = 12&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#222222;strokeWidth=1;fillColor=#e6f4ea;fontSize=15;align=center;verticalAlign=middle;" vertex="1" parent="1">
