        <mxCell id="std2" value="&lt;b&gt;500ms&lt;/b&gt;&lt;br&gt;chrono::milliseconds{500}" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#222222;strokeWidth=1;fillColor=#e8f0fe;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1">
