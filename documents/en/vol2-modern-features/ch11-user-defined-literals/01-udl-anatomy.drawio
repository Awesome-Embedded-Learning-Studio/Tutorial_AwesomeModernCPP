        <mxCell id="std3" value="&lt;b&gt;3.0 + 4.0i&lt;/b&gt;&lt;br&gt;complex&lt;double&gt;{3.0, 4.0}" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#222222;strokeWidth=1;fillColor=#e8f0fe;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1">
