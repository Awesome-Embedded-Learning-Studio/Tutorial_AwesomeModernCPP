        <mxCell id="std4" value="&lt;b&gt;&quot;hello&quot;s&lt;/b&gt;&lt;br&gt;std::string" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#222222;strokeWidth=1;fillColor=#e8f0fe;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1">
