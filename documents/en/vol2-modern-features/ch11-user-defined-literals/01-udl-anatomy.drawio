<mxfile host="app.diagrams.net">
  <diagram name="UDL Anatomy" id="udl-anatomy">
    <mxGraphModel dx="1100" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="用户自定义字面量的解剖：500_ms 如何变成强类型值" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="62" y="26" width="703" height="32" as="geometry" />
        </mxCell>

        <!-- 第一行：500_ms 拆成原始字面量 + 后缀 -->
        <mxCell id="lit_box" value="" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#222222;strokeWidth=2;fillColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="60" y="88" width="210" height="126" as="geometry" />
        </mxCell>
        <mxCell id="lit_num" value="500" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#222222;strokeWidth=1;fillColor=#e8f0fe;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="104" width="85" height="36" as="geometry" />
