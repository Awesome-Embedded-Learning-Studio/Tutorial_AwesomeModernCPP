        <mxCell id="lit_suffix" value="_ms" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#222222;strokeWidth=1;fillColor=#ffe6e6;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="155" y="104" width="105" height="36" as="geometry" />
        </mxCell>
        <mxCell id="lit_cap_num" value="整数字面量&lt;br&gt;cooked：先解析成数值" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=11;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="66" y="148" width="94" height="56" as="geometry" />
        </mxCell>
        <mxCell id="lit_cap_suffix" value="用户自定义后缀&lt;br&gt;必须以 _ 开头" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=11;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="162" y="148" width="100" height="56" as="geometry" />
        </mxCell>

        <mxCell id="arrow_call" value="调用" style="endArrow=classic;html=1;rounded=0;strokeColor=#222222;strokeWidth=2;fontSize=12;fontColor=#555555;" edge="1" parent="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="270" y="150" as="sourcePoint" />
            <mxPoint x="310" y="150" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="fn_card" value="&lt;b&gt;operator&quot;&quot;_ms(500)&lt;/b&gt;&lt;br&gt;constexpr Milliseconds&lt;br&gt;operator&quot;&quot;_ms(unsigned long long v)&lt;br&gt;&lt;font color=&quot;#8a6d00&quot;&gt;整型 cooked 形式，编译期完成&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#222222;strokeWidth=2;fillColor=#fff2cc;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="310" y="88" width="230" height="126" as="geometry" />
        </mxCell>

        <mxCell id="arrow_ret" value="返回" style="endArrow=classic;html=1;rounded=0;strokeColor=#222222;strokeWidth=2;fontSize=12;fontColor=#555555;" edge="1" parent="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="540" y="150" as="sourcePoint" />
            <mxPoint x="580" y="150" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="value_card" value="&lt;b&gt;Milliseconds{500}&lt;/b&gt;&lt;br&gt;带单位的强类型值&lt;br&gt;&lt;font color=&quot;#c00000&quot;&gt;裸整数传不进 delay(Milliseconds)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#222222;strokeWidth=2;fillColor=#e6f4ea;fontSize=14;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="580" y="88" width="183" height="126" as="geometry" />
        </mxCell>

        <mxCell id="raw_note" value="raw 形式则接收原始字符序列：operator&quot;&quot;_bin(const char* str, std::size_t length)，1010_bin 得到 Binary{10}" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#888888;" vertex="1" parent="1">
          <mxGeometry x="62" y="224" width="701" height="20" as="geometry" />
        </mxCell>

        <!-- 第二行：标准库字面量并列对照 -->
        <mxCell id="std_header" value="标准库字面量（std::literals）——后缀不带下划线，保留给标准库" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#1565C0;" vertex="1" parent="1">
