        <!-- 右侧操作卡片 -->
        <mxCell id="c_exists" value="&lt;b&gt;&lt;font color=&quot;#7f6000&quot;&gt;exists(p) 只读查询&lt;/font&gt;&lt;/b&gt;&lt;br&gt;fs::exists(&quot;/tmp/source.txt&quot;)&lt;br&gt;不改动目录树；不存在返回 false" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#222222;strokeWidth=1;fillColor=#fff2cc;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="486" y="132" width="270" height="88" as="geometry" />
        </mxCell>
        <mxCell id="c_copy" value="&lt;b&gt;&lt;font color=&quot;#1f4e9c&quot;&gt;copy(src, dst) 复制&lt;/font&gt;&lt;/b&gt;&lt;br&gt;fs::copy(&quot;/tmp/source.txt&quot;,&lt;br&gt;&quot;/tmp/dest.txt&quot;)&lt;br&gt;from 是普通文件时复制内容，dest.txt 成为新节点（虚线）" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#222222;strokeWidth=1;fillColor=#e8f0fe;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="486" y="230" width="270" height="104" as="geometry" />
        </mxCell>
        <mxCell id="c_create" value="&lt;b&gt;&lt;font color=&quot;#2E7D32&quot;&gt;create_directory / create_directories 新建目录&lt;/font&gt;&lt;/b&gt;&lt;br&gt;fs::create_directory(&quot;/tmp/myapp_config&quot;)&lt;br&gt;父目录 /tmp 必须已存在，否则失败&lt;br&gt;fs::create_directories(&lt;br&gt;&quot;/tmp/myapp/data/cache/tmp&quot;)&lt;br&gt;自动补齐缺失的中间目录，等价 mkdir -p" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#222222;strokeWidth=1;fillColor=#e6f4ea;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="486" y="346" width="270" height="140" as="geometry" />
        </mxCell>
        <mxCell id="c_remove" value="&lt;b&gt;&lt;font color=&quot;#c00000&quot;&gt;remove / remove_all 删除&lt;/font&gt;&lt;/b&gt;&lt;br&gt;fs::remove(&quot;/tmp/temp_file.txt&quot;)&lt;br&gt;删文件或空目录；路径不存在返回 false，不报错&lt;br&gt;fs::remove_all(&quot;/tmp/my_temp_dir&quot;)&lt;br&gt;递归删除整棵子树，返回删除的数量" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#222222;strokeWidth=1;fillColor=#ffe6e6;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="486" y="494" width="270" height="126" as="geometry" />
        </mxCell>

        <!-- 图例 -->
        <mxCell id="legend" value="实线框 = 操作前已存在；虚线框 = 操作新建的节点；红底加 ✕ = 被删除（路径与调用均取自本篇示例代码）" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=11;fontColor=#888888;" vertex="1" parent="1">
