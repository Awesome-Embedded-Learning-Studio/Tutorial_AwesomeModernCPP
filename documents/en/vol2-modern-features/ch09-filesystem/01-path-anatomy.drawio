        <!-- 文章强调的坑：多段扩展名 -->
        <mxCell id="tar_note" value="&lt;b&gt;换成 /tmp/archive.tar.gz：extension() 只取最后一个 &quot;.&quot; 之后的部分&lt;/b&gt;&lt;br&gt;filename() = &quot;archive.tar.gz&quot;，stem() = &quot;archive.tar&quot;，extension() = &quot;.gz&quot;（&lt;font color=&quot;#c00000&quot;&gt;不是 &quot;.tar.gz&quot;&lt;/font&gt;）" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#222222;strokeWidth=1;fillColor=#fff2cc;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
