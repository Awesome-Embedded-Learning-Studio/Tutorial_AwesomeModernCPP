        <mxCell id="r1" value="return std::nullopt;" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#222222;strokeWidth=1;fillColor=#ffffff;fontSize=15;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="434" y="196" width="300" height="40" as="geometry" />
        </mxCell>
        <mxCell id="r2" value="&lt;b&gt;optional 为空（nullopt）&lt;/b&gt;&lt;br&gt;find(99) 的返回结果" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#222222;strokeWidth=1;fillColor=#f2f2f2;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1">
