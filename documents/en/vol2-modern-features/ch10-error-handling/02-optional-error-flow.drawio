          <mxGeometry x="94" y="196" width="300" height="40" as="geometry" />
        </mxCell>
        <mxCell id="l2" value="&lt;b&gt;optional 持有 User（有值）&lt;/b&gt;&lt;br&gt;find(1) 的返回结果" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#222222;strokeWidth=1;fillColor=#e6f4ea;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1">
