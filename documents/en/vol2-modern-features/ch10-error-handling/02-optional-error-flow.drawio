        <mxCell id="access_header" value="调用方的三种访问方式" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="94" y="482" width="640" height="24" as="geometry" />
        </mxCell>
        <mxCell id="card_a" value="&lt;b&gt;if (opt)&lt;/b&gt;&lt;br&gt;先判断有没有值&lt;br&gt;有值为真，空为假" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#222222;strokeWidth=1;fillColor=#fff2cc;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="94" y="514" width="200" height="88" as="geometry" />
        </mxCell>
        <mxCell id="card_b" value="&lt;b&gt;*opt / opt-&gt;成员&lt;/b&gt;&lt;br&gt;确认有值后取值&lt;br&gt;如 *result、user-&gt;name" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#222222;strokeWidth=1;fillColor=#fff2cc;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="314" y="514" width="200" height="88" as="geometry" />
        </mxCell>
        <mxCell id="card_c" value="&lt;b&gt;.value_or(默认值)&lt;/b&gt;&lt;br&gt;为空时直接给默认值&lt;br&gt;LOG_LEVEL 没设置时用 INFO" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#222222;strokeWidth=1;fillColor=#fff2cc;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="534" y="514" width="200" height="88" as="geometry" />
        </mxCell>

        <mxCell id="conclusion" value="&lt;b&gt;语义在类型里&lt;/b&gt;：签名 std::optional&lt;User&gt; 本身就告诉调用方「可能没有值」，不需要查文档、记约定" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#222222;strokeWidth=2;fillColor=#e8f0fe;fontSize=15;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="94" y="630" width="640" height="50" as="geometry" />
        </mxCell>

        <mxCell id="source_note" value="例子取自本文 UserRegistry：registry.find(1) 与 registry.find(99)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=11;fontColor=#888888;" vertex="1" parent="1">
