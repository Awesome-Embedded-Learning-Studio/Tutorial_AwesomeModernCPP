<mxfile host="app.diagrams.net">
  <diagram name="Strong Types Wrapper" id="strong-types-wrapper">
    <mxGraphModel dx="1100" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="同一句 set_rect(h, w)：类型别名 vs 强类型包装" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="113" y="26" width="600" height="32" as="geometry" />
        </mxCell>

        <!-- 左列：类型别名 -->
        <mxCell id="left_header" value="类型别名：using Width = int" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#c00000;" vertex="1" parent="1">
          <mxGeometry x="70" y="72" width="310" height="26" as="geometry" />
        </mxCell>
        <mxCell id="left_box" value="" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#222222;strokeWidth=2;fillColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="70" y="104" width="310" height="118" as="geometry" />
        </mxCell>
        <mxCell id="left_label" value="using Width&amp;nbsp; = int;&lt;br&gt;using Height = int;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="112" width="290" height="48" as="geometry" />
        </mxCell>
        <mxCell id="left_same" value="编译器眼里全是&lt;b&gt;同一个 int&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#888888;strokeWidth=1;dashed=1;fillColor=#f2f2f2;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="90" y="168" width="270" height="34" as="geometry" />
        </mxCell>
        <mxCell id="left_call" value="set_rect(h, w);&amp;nbsp; // 参数顺序反了" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="236" width="310" height="24" as="geometry" />
        </mxCell>
        <mxCell id="left_result" value="&lt;b&gt;编译通过&lt;/b&gt;，没有任何警告" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#222222;strokeWidth=1;fillColor=#ffe6e6;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="70" y="274" width="310" height="40" as="geometry" />
        </mxCell>
        <mxCell id="left_note" value="两个都是 int，类型完全匹配，编译器不吭声；屏幕上的矩形是歪的，只能靠人眼在 code review 里发现" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;spacing=2;" vertex="1" parent="1">
          <mxGeometry x="70" y="326" width="310" height="60" as="geometry" />
        </mxCell>

        <!-- 右列：强类型包装 -->
        <mxCell id="right_header" value="强类型包装：StrongInt&lt;WidthTag&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#2E7D32;" vertex="1" parent="1">
          <mxGeometry x="447" y="72" width="310" height="26" as="geometry" />
        </mxCell>
        <mxCell id="right_box" value="" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#222222;strokeWidth=2;fillColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="447" y="104" width="310" height="118" as="geometry" />
        </mxCell>
        <mxCell id="right_label" value="using Width&amp;nbsp; = StrongInt&lt;WidthTag&gt;;&lt;br&gt;using Height = StrongInt&lt;HeightTag&gt;;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="457" y="112" width="290" height="48" as="geometry" />
        </mxCell>
        <mxCell id="right_same" value="编译器眼里是&lt;b&gt;两个不同的类型&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#888888;strokeWidth=1;dashed=1;fillColor=#f2f2f2;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="467" y="168" width="270" height="34" as="geometry" />
        </mxCell>
        <mxCell id="right_call" value="set_rect(h, w);&amp;nbsp; // 同一句调用" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="447" y="236" width="310" height="24" as="geometry" />
        </mxCell>
        <mxCell id="right_result" value="&lt;b&gt;编译错误！&lt;/b&gt;参数类型不匹配" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#222222;strokeWidth=1;fillColor=#e6f4ea;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="447" y="274" width="310" height="40" as="geometry" />
        </mxCell>
        <mxCell id="right_note" value="错误在编译期被拦截；Tag 只在编译期起作用，StrongInt 运行时表现和裸 int 完全一样" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;spacing=2;" vertex="1" parent="1">
          <mxGeometry x="447" y="326" width="310" height="60" as="geometry" />
        </mxCell>

        <!-- 底部：StrongInt 结构 -->
        <mxCell id="band_title" value="StrongInt&lt;Tag, Rep&gt;：Tag 区分类型，Rep 底层存储" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="113" y="408" width="600" height="26" as="geometry" />
        </mxCell>
        <mxCell id="card_tag" value="&lt;b&gt;幽灵标签 Tag&lt;/b&gt;&lt;br&gt;struct WidthTag {};&lt;br&gt;空类，只做类型标记，不占存储空间" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#222222;strokeWidth=1;fillColor=#fff2cc;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="113" y="446" width="188" height="100" as="geometry" />
        </mxCell>
        <mxCell id="card_ctor" value="&lt;b&gt;显式构造&lt;/b&gt;&lt;br&gt;explicit StrongInt(Rep value)&lt;br&gt;int 不会隐式变成 Width" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#222222;strokeWidth=1;fillColor=#e8f0fe;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="319" y="446" width="188" height="100" as="geometry" />
        </mxCell>
        <mxCell id="card_ops" value="&lt;b&gt;同类型才可运算&lt;/b&gt;&lt;br&gt;+ - == 只接受同 Tag 特化&lt;br&gt;get() 取回底层值" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#222222;strokeWidth=1;fillColor=#f2f2f2;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="525" y="446" width="188" height="100" as="geometry" />
        </mxCell>
        <mxCell id="footer" value="图中代码与结论取自本文 set_rect / StrongInt 示例" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=11;fontColor=#888888;" vertex="1" parent="1">
          <mxGeometry x="113" y="558" width="600" height="20" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
