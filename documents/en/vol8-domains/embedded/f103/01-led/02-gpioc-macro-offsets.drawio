<mxfile host="app.diagrams.net">
  <diagram name="GPIOC Macro Chain and Offsets" id="gpioc-macro-offsets">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="从 #define 到地址：GPIOC 宏链与 GPIO_TypeDef 偏移" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="140" y="18" width="520" height="32" as="geometry" />
        </mxCell>

        <!-- ===================== Macro chain ===================== -->
        <mxCell id="periph" value="&lt;b&gt;PERIPH_BASE&lt;/b&gt;&lt;br&gt;0x40000000" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#1565C0;strokeWidth=2;fillColor=#E3F2FD;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="50" y="66" width="170" height="50" as="geometry" />
        </mxCell>
        <mxCell id="apb2" value="&lt;b&gt;APB2PERIPH_BASE&lt;/b&gt;&lt;br&gt;0x40010000" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#1565C0;strokeWidth=2;fillColor=#E3F2FD;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="330" y="66" width="170" height="50" as="geometry" />
        </mxCell>
        <mxCell id="gpiocbase" value="&lt;b&gt;GPIOC_BASE&lt;/b&gt;&lt;br&gt;0x40011000" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#E65100;strokeWidth=2.5;fillColor=#FFF3E0;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="610" y="66" width="170" height="50" as="geometry" />
        </mxCell>

        <mxCell id="m1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1565C0;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="periph" target="apb2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m1l" value="+ 0x10000" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#1565C0;" vertex="1" parent="1">
          <mxGeometry x="220" y="48" width="100" height="24" as="geometry" />
        </mxCell>
        <mxCell id="m2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1565C0;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="apb2" target="gpiocbase">
