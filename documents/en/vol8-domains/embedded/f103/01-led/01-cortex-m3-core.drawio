<mxfile host="app.diagrams.net">
  <diagram name="Cortex-M3 Core Anatomy" id="cortex-m3-core">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="560" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="Cortex-M3 内核家底：寄存器 · 流水线 · 总线" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="140" y="20" width="520" height="35" as="geometry" />
        </mxCell>

        <!-- Core dashed frame -->
        <mxCell id="core" value="" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;strokeColor=#455A64;strokeWidth=1.5;fillColor=none;verticalAlign=top;fontSize=13;fontStyle=1;fontColor=#455A64;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="730" height="270" as="geometry" />
        </mxCell>

        <!-- ===================== Region 1: registers ===================== -->
        <mxCell id="reg_title" value="工作台：一把寄存器" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#1565C0;" vertex="1" parent="1">
          <mxGeometry x="60" y="82" width="190" height="24" as="geometry" />
        </mxCell>

        <mxCell id="r0" value="R0" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#1565C0;strokeWidth=1.5;fillColor=#E3F2FD;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="65" y="110" width="80" height="40" as="geometry" />
        </mxCell>
        <mxCell id="r1" value="R1" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#1565C0;strokeWidth=1.5;fillColor=#E3F2FD;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="65" y="154" width="80" height="40" as="geometry" />
        </mxCell>
        <mxCell id="rdots" value="⋮" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=16;fontColor=#1565C0;" vertex="1" parent="1">
          <mxGeometry x="65" y="198" width="80" height="40" as="geometry" />
        </mxCell>
        <mxCell id="r12" value="R12" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#1565C0;strokeWidth=1.5;fillColor=#E3F2FD;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="65" y="242" width="80" height="40" as="geometry" />
        </mxCell>

        <mxCell id="sp" value="SP · R13&lt;br&gt;（MSP / PSP）" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#E65100;strokeWidth=1.5;fillColor=#FFF3E0;fontSize=12;align=center;verticalAlign=middle;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="155" y="110" width="100" height="40" as="geometry" />
        </mxCell>
        <mxCell id="lr" value="LR · R14" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#E65100;strokeWidth=1.5;fillColor=#FFF3E0;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="155" y="154" width="100" height="40" as="geometry" />
        </mxCell>
        <mxCell id="pc" value="PC · R15" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#E65100;strokeWidth=1.5;fillColor=#FFF3E0;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="155" y="198" width="100" height="40" as="geometry" />
        </mxCell>
        <mxCell id="xpsr" value="xPSR&lt;br&gt;（记标志）" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#E65100;strokeWidth=1.5;fillColor=#FFF3E0;fontSize=12;align=center;verticalAlign=middle;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="155" y="242" width="100" height="40" as="geometry" />
        </mxCell>

        <mxCell id="reg_note" value="13 个通用 + 3 个带专职 + xPSR&lt;br&gt;运算指令只碰这里，想碰内存只有 ldr / str" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=11;fontColor=#616161;" vertex="1" parent="1">
          <mxGeometry x="55" y="290" width="210" height="36" as="geometry" />
        </mxCell>

        <!-- ===================== Region 2: pipeline ===================== -->
        <mxCell id="pipe_title" value="三级流水线" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#C62828;" vertex="1" parent="1">
          <mxGeometry x="300" y="82" width="220" height="24" as="geometry" />
        </mxCell>

        <mxCell id="fe" value="&lt;b&gt;Fe&lt;/b&gt;&lt;br&gt;取指" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#C62828;strokeWidth=2;fillColor=#FFEBEE;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="300" y="125" width="64" height="55" as="geometry" />
        </mxCell>
        <mxCell id="de" value="&lt;b&gt;De&lt;/b&gt;&lt;br&gt;译码" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#C62828;strokeWidth=2;fillColor=#FFEBEE;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="378" y="125" width="64" height="55" as="geometry" />
        </mxCell>
        <mxCell id="ex" value="&lt;b&gt;Ex&lt;/b&gt;&lt;br&gt;执行" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#C62828;strokeWidth=2;fillColor=#FFEBEE;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="456" y="125" width="64" height="55" as="geometry" />
        </mxCell>

        <mxCell id="fe_de" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#C62828;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="fe" target="de">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="de_ex" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#C62828;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="de" target="ex">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="fe_note" value="从代码区&lt;br&gt;抓回指令" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=11;fontColor=#616161;" vertex="1" parent="1">
          <mxGeometry x="290" y="188" width="84" height="36" as="geometry" />
        </mxCell>
        <mxCell id="de_note" value="弄清要干啥&lt;br&gt;顺手算出地址" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=11;fontColor=#616161;" vertex="1" parent="1">
          <mxGeometry x="368" y="188" width="84" height="36" as="geometry" />
        </mxCell>
        <mxCell id="ex_note" value="真正做运算&lt;br&gt;交给总线接口" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=11;fontColor=#616161;" vertex="1" parent="1">
          <mxGeometry x="446" y="188" width="84" height="36" as="geometry" />
        </mxCell>

        <mxCell id="pipe_note" value="地址是译码时算好的&lt;br&gt;真正碰内存是执行时的事" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#C62828;" vertex="1" parent="1">
          <mxGeometry x="290" y="240" width="210" height="44" as="geometry" />
        </mxCell>

        <!-- ===================== Region 3: buses ===================== -->
        <mxCell id="bus_title" value="对外四条总线" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#4A148C;" vertex="1" parent="1">
          <mxGeometry x="560" y="82" width="196" height="24" as="geometry" />
        </mxCell>

        <mxCell id="icode" value="&lt;b&gt;I-Code&lt;/b&gt;&lt;br&gt;取指令 · 代码区" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#4A148C;strokeWidth=1.5;fillColor=#F3E5F5;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="565" y="112" width="186" height="40" as="geometry" />
        </mxCell>
        <mxCell id="dcode" value="&lt;b&gt;D-Code&lt;/b&gt;&lt;br&gt;代码区的数据读写" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#4A148C;strokeWidth=1.5;fillColor=#F3E5F5;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="565" y="162" width="186" height="40" as="geometry" />
        </mxCell>
        <mxCell id="sysbus" value="&lt;b&gt;System&lt;/b&gt;&lt;br&gt;其余全部空间" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#4A148C;strokeWidth=1.5;fillColor=#F3E5F5;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="565" y="212" width="186" height="40" as="geometry" />
        </mxCell>
        <mxCell id="ppb" value="&lt;b&gt;PPB&lt;/b&gt;&lt;br&gt;NVIC、SysTick（内核私有）" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#4A148C;strokeWidth=1.5;fillColor=#F3E5F5;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="565" y="262" width="186" height="40" as="geometry" />
        </mxCell>

        <!-- Ex feeds the bus interfaces -->
        <mxCell id="ex_bus" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;rounded=0;html=1;strokeColor=#9E9E9E;strokeWidth=1.5;dashed=1;endArrow=block;endFill=1;" edge="1" parent="1" source="ex" target="sysbus">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="545" y="152" /><mxPoint x="545" y="232" /></Array></mxGeometry>
        </mxCell>

        <!-- Bottom note -->
        <mxCell id="bottom_note" value="哈佛式只到总线：取指走 I-Code、取数走 D-Code / System，互不排队；&lt;br&gt;但程序员看到的地址是统一 4GB —— 路分着修，地址一起编（分区表见下文）" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=13;fontColor=#37474F;" vertex="1" parent="1">
          <mxGeometry x="40" y="360" width="730" height="56" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
