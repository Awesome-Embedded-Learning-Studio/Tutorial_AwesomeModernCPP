<mxfile host="app.diagrams.net">
  <diagram id="fpb-breakpoints" name="断点的物理课">
    <mxGraphModel dx="900" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="960" pageHeight="460" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="grp1" value="真机：FPB 是块真实硬件" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#999999;fontSize=14;fontStyle=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="60" y="60" width="770" height="210" as="geometry"/>
        </mxCell>
