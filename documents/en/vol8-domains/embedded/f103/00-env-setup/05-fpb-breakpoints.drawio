        <mxCell id="halt" value="CPU 停机" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="710" y="130" width="100" height="46" as="geometry"/>
