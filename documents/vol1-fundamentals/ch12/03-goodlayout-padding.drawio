        <mxCell id="summary" value="成员合计 6 字节 + 填充 2 字节 = &lt;b&gt;sizeof(GoodLayout) = 8&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#222222;strokeWidth=1;fillColor=#e6f4ea;fontSize=15;align=center;verticalAlign=middle;" vertex="1" parent="1">
