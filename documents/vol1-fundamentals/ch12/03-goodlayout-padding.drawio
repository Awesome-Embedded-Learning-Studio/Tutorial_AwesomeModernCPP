        <mxCell id="ann-tail" value="成员合计 6 字节，整体大小凑成 4 的倍数，尾巴补 2 字节到 8" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=13;fontColor=#555555;" vertex="1" parent="1">
