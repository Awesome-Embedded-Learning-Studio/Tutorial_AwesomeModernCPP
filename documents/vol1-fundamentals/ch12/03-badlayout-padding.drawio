          </mxGeometry>
        </mxCell>
        <mxCell id="ann-tail" value="整体大小须为 4 的倍数：排完 9 字节，尾巴再补 3 字节凑成 12" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=13;fontColor=#555555;" vertex="1" parent="1">
