        <!-- 注释带：两处填充的成因 -->
        <mxCell id="ann-align" value="int b 要按 4 字节对齐，只能落在偏移 4；偏移 1–3 被垫成填充" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=13;fontColor=#555555;" vertex="1" parent="1">
