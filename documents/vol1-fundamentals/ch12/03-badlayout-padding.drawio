        <mxCell id="summary" value="成员合计 6 字节 + 填充 6 字节 = &lt;b&gt;sizeof(BadLayout) = 12&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#222222;strokeWidth=1;fillColor=#fff2cc;fontSize=15;align=center;verticalAlign=middle;" vertex="1" parent="1">
